// Modelo de dados do AgendaFácil.
// Banco: PostgreSQL (Supabase). Veja .env.example para as URLs de conexão.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexão via pooler do Supabase (porta 6543), usada pelo sistema
  url       = env("DATABASE_URL")
  // Conexão direta (porta 5432), usada para criar/alterar as tabelas (migrations)
  directUrl = env("DIRECT_URL")
}

// Estabelecimento (barbearia, salão, clínica...). Cada um é um "tenant".
model Business {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  phone             String?
  // Endereço montado (rua, número - bairro, cidade - UF), usado na página e no "Como chegar"
  address           String?
  // Partes do endereço (preenchidas pelo CEP no cadastro e nas configurações)
  zipCode           String?
  street            String?
  addressNumber     String?
  complement        String?
  district          String?
  city              String?
  state             String?
  description       String?
  // BARBEARIA | SALAO | ESTETICA | UNHAS | SOBRANCELHA | SAUDE | OUTRO
  businessType      String   @default("OUTRO")
  // Atende sem endereço fixo (a domicílio)
  homeService       Boolean  @default(false)
  // Quando terminou (ou pulou) a configuração inicial; null = ainda não terminou
  onboardedAt       DateTime?
  // Último passo concluído da configuração guiada (0 = nenhum)
  onboardingStep    Int      @default(0)
  // Intervalo entre horários exibidos na página de agendamento (minutos)
  slotInterval      Int      @default(30)
  // Antecedência mínima para o cliente agendar (minutos)
  minAdvanceMinutes Int      @default(60)
  // Até quantos dias no futuro o cliente pode agendar
  maxAdvanceDays    Int      @default(30)
  // Intervalo livre depois de cada atendimento (limpeza, descanso), em minutos
  bufferMinutes     Int      @default(0)
  // Cliente pelo link: FREE (até a hora) | DEADLINE (até cancelDeadlineMinutes antes) | NEVER (só falando com o salão)
  clientCancelPolicy    String  @default("FREE")
  cancelDeadlineMinutes Int     @default(120)
  // Cliente pode trocar dia/horário pelo link (respeitando o mesmo prazo do cancelamento)
  clientCanReschedule   Boolean @default(true)

  // ----- Página pública (visual) -----
  brandColor    String? // cor dos botões, ex.: #E85F00 (null = laranja HoraBoa)
  tagline       String? // frase curta abaixo do nome
  instagram     String? // @perfil
  mapsUrl       String? // link do Google Maps (se vazio, usa o endereço)
  reviewUrl     String? // link "Avalie no Google"
  logoImageId   String?
  coverImageId  String?
  pageTheme     String  @default("LIGHT") // LIGHT | DARK
  bgPattern     String  @default("NONE") // desenho de fundo (ver src/components/patterns.tsx)
  bgGlow        String  @default("BRAND") // luz do fundo: BRAND (na cor do salão), NONE ou um degradê pronto (ver src/lib/glows.ts)
  createdAt         DateTime @default(now())

  // ----- Assinatura do estabelecimento -----
  // TRIALING | ACTIVE | PAST_DUE | CANCELED
  subscriptionStatus   String    @default("TRIALING")
  trialEndsAt          DateTime  @default(dbgenerated("(now() + '7 days'::interval)"))
  plan                 String? // MONTHLY | SEMIANNUAL | ANNUAL
  paymentMethod        String? // CARD | PIX
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  taxId                String? // CPF/CNPJ (necessário para Pix)
  billingPhone         String? // telefone do pagador (necessário para Pix)
  // Pix pela Asaas (assinatura com renovação gerada pela Asaas)
  asaasCustomerId      String?   @unique
  asaasSubscriptionId  String?   @unique
  asaasPlan            String? // plano da assinatura Asaas (MONTHLY | SEMIANNUAL | ANNUAL)

  // ----- WhatsApp (Evolution API: o salão conecta o próprio número por QR code) -----
  whatsappRemindersEnabled Boolean   @default(true)
  whatsappInstance         String?   @unique // nome da instância na Evolution API
  // DISCONNECTED | CONNECTING | CONNECTED
  whatsappStatus           String    @default("DISCONNECTED")
  whatsappNumber           String?
  whatsappConnectedAt      DateTime?
  // Quando enviar (configurável por estabelecimento)
  confirmationEnabled      Boolean   @default(true)
  // OFF | 24H (24 horas antes) | EVENING (na véspera, no horário reminderDayTime)
  reminderDayMode          String    @default("24H")
  reminderDayTime          Int       @default(1080) // minutos desde 00:00 (1080 = 18:00)
  reminderShortMinutes     Int       @default(60) // 0 = desligado
  // Textos personalizados (null = usar o texto padrão)
  msgConfirmation          String?
  msgReminder              String?

  users         User[]
  services      Service[]
  professionals Professional[]
  workingHours  WorkingHour[]
  clients       Client[]
  appointments  Appointment[]
  payments      Payment[]
  messageLogs   MessageLog[]
  timeBlocks    TimeBlock[]
  images        BusinessImage[]
  products      Product[]
  stockMoves    StockMove[]
  expenses      Expense[]
  // Taxa da maquininha/banco por forma de pagamento, em centésimos de % (349 = 3,49%)
  feePixBps     Int @default(0)
  feeCashBps    Int @default(0)
  feeDebitBps   Int @default(0)
  feeCreditBps  Int @default(0)
  // Agendamento pelo link: true = já entra confirmado; false = fica "A confirmar" até o dono aprovar
  autoConfirm   Boolean @default(true)
  // Cartão fidelidade
  loyaltyEnabled       Boolean   @default(false)
  loyaltyGoal          Int       @default(10) // selos para ganhar o prêmio
  loyaltyRewardType    String    @default("FREE_SERVICE") // FREE_SERVICE | PERCENT (bps) | AMOUNT (centavos)
  loyaltyRewardServiceId String?
  loyaltyRewardValue   Int       @default(0)
  loyaltyServiceIds    String[]  @default([]) // vazio = todos os serviços contam
  loyaltyStampMonths   Int?      // selos vencem depois de X meses (null = não vencem)
  loyaltyRewardDays    Int?      @default(90) // prêmio vale X dias (null = não vence)
  loyaltyNotify        Boolean   @default(true) // avisar no WhatsApp
  loyaltyStartedAt     DateTime? // atendimentos a partir daqui contam selo
  loyaltyStamps        LoyaltyStamp[]
  loyaltyRewards       LoyaltyReward[]
  adminActions AdminAction[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OWNER")
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  termsAcceptedAt DateTime?
  // Aumenta quando a senha muda: derruba o login salvo nos outros aparelhos
  sessionVersion Int      @default(0)
  // Proteção contra chute de senha: após várias tentativas erradas, o login fica travado por alguns minutos
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  panelTheme   String   @default("LIGHT") // tema do painel: LIGHT | DARK (chave no topo do painel)
  // Como a agenda abre (fica salvo na conta): DIA | SEMANA | LISTA, profissional (null = todos) e cancelados
  agendaView         String   @default("dia")
  agendaProfessional String?
  agendaShowCanceled Boolean  @default(false)
  createdAt    DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  lessonViews         LessonView[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Guardamos só o hash do token; o token puro vai apenas no e-mail
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Pagamentos da assinatura (histórico de cartão e cobranças Pix)
model Payment {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider    String // STRIPE | SYNCPAY
  method      String // CARD | PIX
  plan        String // MONTHLY | SEMIANNUAL | ANNUAL
  amountCents Int
  // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  status      String    @default("PENDING")
  externalId  String?   @unique
  pixCopyPaste String?
  pixQrCode   String? // imagem base64 ou URL do QR code
  expiresAt   DateTime?
  paidAt      DateTime?
  // Consultas de status feitas ao provedor (a SyncPay limita a 5 por cobrança)
  statusChecks Int      @default(0)
  createdAt   DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([status, method, createdAt])
}

// Registro de mensagens enviadas (WhatsApp)
model MessageLog {
  id                String       @id @default(cuid())
  businessId        String
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String?
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  channel           String       @default("WHATSAPP")
  // CONFIRMATION | REMINDER_DAY | REMINDER_SHORT
  type              String
  to                String
  // SENT | FAILED | SKIPPED
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime     @default(now())

  @@index([businessId, createdAt])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  imageId         String? // foto do serviço (BusinessImage, kind SERVICE)
  createdAt       DateTime @default(now())

  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId])
}

model Professional {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  imageId    String? // foto do profissional (BusinessImage, kind PROFESSIONAL)
  // Comissão: NONE | PERCENT (commissionRate em centésimos de %) | PER_SERVICE (centavos por atendimento) | SALARY (centavos por mês)
  commissionType     String @default("NONE")
  commissionRate     Int    @default(0)
  productCommissionBps Int  @default(0) // % sobre os produtos que ele vender
  productSales       StockMove[]
  active     Boolean  @default(true)
  // false = segue o horário do estabelecimento; true = usa ProfessionalHour
  customHours Boolean @default(false)
  createdAt  DateTime @default(now())

  services     ProfessionalService[]
  appointments Appointment[]
  hours        ProfessionalHour[]
  timeBlocks   TimeBlock[]

  @@index([businessId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

// Horário de funcionamento por dia da semana (0 = domingo ... 6 = sábado).
// Horários são guardados em minutos desde 00:00 no fuso local do estabelecimento.
model WorkingHour {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday      Int
  isOpen       Boolean  @default(true)
  startMinutes Int
  endMinutes   Int
  breakStart   Int?
  breakEnd     Int?

  @@unique([businessId, weekday])
}

// Horário próprio de um profissional (quando customHours = true). Mesmo formato de WorkingHour.
model ProfessionalHour {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  isOpen         Boolean      @default(true)
  startMinutes   Int
  endMinutes     Int
  breakStart     Int?
  breakEnd       Int?

  @@unique([professionalId, weekday])
}

// Bloqueio de agenda: folga, férias, compromisso. professionalId null = vale para todos.
model TimeBlock {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // ONCE: de date até endDate (ou só date) | WEEKLY: todo weekday, a partir de date (e até endDate, se tiver)
  kind           String        @default("ONCE")
  date           String
  endDate        String?
  weekday        Int?
  // Horário bloqueado; ambos null = dia inteiro
  startMinutes   Int?
  endMinutes     Int?
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([businessId, date])
}

model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  createdAt  DateTime @default(now())

  appointments Appointment[]
  productSales StockMove[]
  loyaltyStamps  LoyaltyStamp[]
  loyaltyRewards LoyaltyReward[]

  @@unique([businessId, phone])
}

// Status: SCHEDULED | CONFIRMED | COMPLETED | CANCELED | NO_SHOW
model Appointment {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Data local "YYYY-MM-DD" e horário em minutos desde 00:00 (fuso do estabelecimento)
  date           String
  startMinutes   Int
  endMinutes     Int
  status         String       @default("SCHEDULED")
  priceCents     Int
  notes          String?
  source         String       @default("ONLINE") // ONLINE | MANUAL | QUICK | IMPORT
  // Pagamento do atendimento (controle do dono): PENDING = a receber, PAID = pago
  paymentStatus  String       @default("PENDING")
  paymentMethod  String? // PIX | CASH | CARD
  paidAt         DateTime?
  // Prêmio do cartão fidelidade usado neste atendimento (não gera selo)
  loyaltyRewardId String? @unique
  loyaltyReward   LoyaltyReward? @relation("RewardUse", fields: [loyaltyRewardId], references: [id], onDelete: SetNull)
  loyaltyStamp    LoyaltyStamp?
  cancelToken    String       @unique @default(cuid())
  createdAt      DateTime     @default(now())

  confirmationSentAt DateTime?
  reminderDaySentAt   DateTime? // lembrete antecipado (24h antes ou véspera)
  reminderShortSentAt DateTime? // lembrete próximo do horário
  messageLogs        MessageLog[]

  @@index([businessId, date])
  @@index([date, status])
  @@index([professionalId, date])
  @@index([businessId, paymentStatus])
}

// Imagens da página pública (logo e capa), já reduzidas no navegador antes do envio.
// Cada envio cria uma imagem nova (URL nunca muda de conteúdo, então pode ficar em cache para sempre).
model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // LOGO | COVER | SERVICE | PROFESSIONAL | PRODUCT
  mime       String
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Configurações gerais do site (editadas no painel admin). Ex.: link do vídeo "Como funciona".
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// O que o admin fez na conta de um cliente (estender acesso, ativar plano, cancelar...).
model AdminAction {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adminEmail String
  // EXTEND | GRANT_PLAN | CANCEL
  action     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// Produto vendido no estabelecimento (pomada, óleo, acessório...). Estoque em unidades.
model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  code        String? // código de barras / SKU
  priceCents  Int
  costCents   Int?
  stock       Int      @default(0)
  minStock    Int? // avisa "estoque baixo" quando chegar nisso
  description String?
  imageId     String? // foto (BusinessImage, kind PRODUCT)
  active      Boolean  @default(true) // false = oculto (não aparece para vender)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moves StockMove[]

  @@index([businessId, active])
}

// Movimentação de estoque: entrada, saída (perda/uso) e venda. quantity é com sinal; balance é o saldo depois.
model StockMove {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind          String // IN | OUT | SALE
  quantity      Int
  balance       Int
  note          String?
  // venda
  totalCents    Int?
  paymentMethod String? // PIX | CASH | CARD
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  costCents     Int? // custo total do que foi vendido (para o lucro)
  professionalId String? // quem vendeu (comissão sobre produtos)
  professional  Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
}

// Despesa do estabelecimento (aluguel, luz, material...). Fixa = repete todo mês no mesmo dia até endDate.
model Expense {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  category    String // ALUGUEL | CONTAS | MATERIAL | MARKETING | PESSOAL | OUTROS
  amountCents Int
  date        String // "YYYY-MM-DD" (primeira vez, se for fixa)
  recurring   Boolean  @default(false)
  endDate     String? // fixa: até quando repete (null = continua)
  createdAt   DateTime @default(now())

  @@index([businessId, date])
}

// Selo do cartão fidelidade. Atendimento (automático) ou dado na mão. rewardId preenchido = já virou prêmio.
model LoyaltyStamp {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  date          String // dia do atendimento "YYYY-MM-DD" (1 selo por dia)
  source        String   @default("APPOINTMENT") // APPOINTMENT | MANUAL
  rewardId      String?
  reward        LoyaltyReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([businessId, clientId])
}

// Prêmio liberado ao completar o cartão.
model LoyaltyReward {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // o que vale (copiado da regra no momento em que liberou)
  rewardType  String
  rewardValue Int
  rewardServiceId String?
  label       String
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  stamps      LoyaltyStamp[]
  usedOn      Appointment? @relation("RewardUse")

  @@index([businessId, clientId])
}

// ---------- Aulas do HoraBoa (quadro de aulas no Suporte, cadastradas no admin) ----------

model LessonModule {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("🎓")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  lessons   Lesson[]
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      LessonModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  youtubeId   String
  // duração em segundos (opcional, só para mostrar)
  durationSec Int?
  position    Int          @default(0)
  published   Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  views       LessonView[]

  @@index([moduleId, position])
}

// Quem marcou a aula como assistida
model LessonView {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([lessonId, userId])
  @@index([userId])
}
