# ===================== OBRIGATÓRIAS =====================

# Banco de dados: Supabase (PostgreSQL)
# No Supabase: botão "Connect" > aba "ORMs" > "Prisma". Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo dos cookies de login (texto longo e aleatório)
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

APP_TIMEZONE="America/Sao_Paulo"

# Endereço público do sistema (usado em e-mails, WhatsApp e retorno dos pagamentos)
APP_URL="https://horaboa.com"

# ===================== PAGAMENTOS =====================

# Stripe (cartão) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Webhook: https://dashboard.stripe.com/webhooks → endpoint  {APP_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# Pix (Asaas) — tem prioridade sobre a SyncPay quando configurado.
# Chave: Asaas → Integrações → Chaves de API. Chaves de teste (Sandbox) contêm "_hmlg_" e usam o Sandbox automaticamente.
# ATENÇÃO: neste arquivo, escreva \$ no lugar do $ inicial da chave (ex.: "\$aact_prod_..."). Na Vercel, cole a chave normal.
ASAAS_API_KEY=""
# Token que você define ao criar o webhook na Asaas (32 a 255 caracteres, sem espaços)
ASAAS_WEBHOOK_TOKEN=""

# Pix (SyncPay, alternativa) — painel SyncPay: Developer → API (chave com permissões Consulta e Venda)
SYNCPAY_CLIENT_ID=""
SYNCPAY_CLIENT_SECRET=""
# Segredo ("token") do webhook do evento "transaction" apontando para {APP_URL}/api/webhooks/pix
SYNCPAY_WEBHOOK_SECRET=""
# Teste local sem SyncPay: PIX_PROVIDER="mock" (nunca funciona na Vercel)
PIX_PROVIDER=""

# ===================== WHATSAPP (Evolution API) =====================
# Servidor da Evolution API (ex.: instalado na Railway) e a chave global dele (AUTHENTICATION_API_KEY)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# Chave que o agendador de lembretes envia (Authorization: Bearer ...)
CRON_SECRET=""

# ===================== E-MAIL (Resend) =====================
RESEND_API_KEY=""
EMAIL_FROM="HoraBoa <nao-responda@horaboa.com>"

# Suporte: WhatsApp exibido na página de Suporte do painel (DDD + número). Opcional.
SUPPORT_WHATSAPP=""
