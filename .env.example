# ===== Banco de dados: Supabase (PostgreSQL) =====
# No painel do Supabase: botão "Connect" (topo) > aba "ORMs" > "Prisma".
# Copie as duas URLs e troque [YOUR-PASSWORD] pela senha do banco.

# Conexão pelo pooler (porta 6543) — usada pelo sistema
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432) — usada para criar as tabelas
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo para assinar os cookies de sessão (qualquer texto longo e aleatório)
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

# Fuso horário dos estabelecimentos
APP_TIMEZONE="America/Sao_Paulo"
